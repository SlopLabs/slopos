.idea/
.cache/
.vscode/
builddir/
third_party/*
# The owned `slopos` sysroot (scripts/make_slopos_sysroot.sh materialises it
# from the pinned toolchain plus the toolchain/ fork overlay). Named rather
# than left to `third_party/*` above because it is generated, not fetched.
third_party/rust-slopos/
# The pinned rustc source tree carrying the compiler fork
# (scripts/make_rustc_src.sh), named for the same reason.
third_party/slopos-rustc-src/
test_output.log
*.swp
*.iso

# Rust build artifacts
target/
**/*.rs.bk

# Runtime filesystem images (generated by build/test), and the repository the
# guest pushes into (`just boot`'s git peer).
fs/assets/*.img
fs/assets/*.img.stamp
fs/assets/*.img.host/
fs/assets/*.git/

# Python cache artifacts
__pycache__/
*.pyc
