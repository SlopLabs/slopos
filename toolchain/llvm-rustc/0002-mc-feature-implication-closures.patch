+namespace {
+/// The transitive closures of one feature table's implication graph, indexed
+/// by feature value. A feature not in the table implies nothing.
+struct FeatureClosures {
+  /// Implied[F]: every feature F implies, directly or through a chain of
+  /// features in the table.
+  std::vector<FeatureBitset> Implied;
+  /// Implying[F]: every feature in the table that transitively implies F.
+  std::vector<FeatureBitset> Implying;
+
+  explicit FeatureClosures(ArrayRef<SubtargetFeatureKV> FeatureTable)
+      : Implied(MAX_SUBTARGET_FEATURES), Implying(MAX_SUBTARGET_FEATURES) {
+    for (const SubtargetFeatureKV &FE : FeatureTable)
+      Implied[FE.Value] |= FE.Implies.getAsBitset();
+    // Fold each implied feature's set into its implier's until nothing grows.
+    for (bool Changed = true; Changed;) {
+      Changed = false;
+      for (const SubtargetFeatureKV &FE : FeatureTable) {
+        FeatureBitset Grown = Implied[FE.Value];
+        for (unsigned I : Implied[FE.Value])
+          Grown |= Implied[I];
+        if (Grown != Implied[FE.Value]) {
+          Implied[FE.Value] = Grown;
+          Changed = true;
+        }
+      }
+    }
+    for (const SubtargetFeatureKV &FE : FeatureTable)
+      for (unsigned I : Implied[FE.Value])
+        Implying[I].set(FE.Value);
+  }
+};
+} // end anonymous namespace
+
+/// The closures of \p FeatureTable, computed on first use. Every subtarget of
+/// a target shares its table, a compiler builds a subtarget per code
+/// generation unit, and it builds them on several threads. Never freed: the
+/// tables are static, and a thread may still be building a subtarget while
+/// the process runs its exit handlers.
+static const FeatureClosures &
+getFeatureClosures(ArrayRef<SubtargetFeatureKV> FeatureTable) {
+  static std::mutex *Lock = new std::mutex;
+  static auto *Cache =
+      new DenseMap<const SubtargetFeatureKV *, const FeatureClosures *>;
+  std::lock_guard<std::mutex> Guard(*Lock);
+  const FeatureClosures *&Closures = (*Cache)[FeatureTable.data()];
+  if (!Closures)
+    Closures = new FeatureClosures(FeatureTable);
+  return *Closures;
+}
