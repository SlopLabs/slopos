diff --git a/compiler/rustc_target/src/spec/base/slopos.rs b/compiler/rustc_target/src/spec/base/slopos.rs
new file mode 100644
--- /dev/null
+++ b/compiler/rustc_target/src/spec/base/slopos.rs
@@ -0,0 +1,14 @@
+use crate::spec::{Env, Os, TargetOptions, cvs};
+
+pub(crate) fn opts() -> TargetOptions {
+    TargetOptions {
+        os: Os::Slopos,
+        env: Env::Slibc,
+        families: cvs!["unix"],
+        dynamic_linking: true,
+        has_rpath: true,
+        has_thread_local: true,
+        no_default_libraries: false,
+        ..Default::default()
+    }
+}
diff --git a/compiler/rustc_target/src/spec/targets/x86_64_unknown_slopos.rs b/compiler/rustc_target/src/spec/targets/x86_64_unknown_slopos.rs
new file mode 100644
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/x86_64_unknown_slopos.rs
@@ -0,0 +1,29 @@
+use crate::spec::{Arch, CodeModel, StackProbeType, Target, TargetMetadata, base};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::slopos::opts();
+    base.cpu = "x86-64".into();
+    base.max_atomic_width = Some(64);
+    base.code_model = Some(CodeModel::Small);
+    base.features = "-mmx,+xsave,+avx,+avx2".into();
+    base.stack_probes = StackProbeType::Inline;
+    // A SlopOS signal frame is written at the interrupted `rsp`, so a leaf
+    // function's red zone does not survive signal delivery.
+    base.disable_redzone = true;
+    base.emit_debug_gdb_scripts = false;
+
+    Target {
+        llvm_target: "x86_64-unknown-none-elf".into(),
+        metadata: TargetMetadata {
+            description: Some("SlopOS".into()),
+            tier: Some(3),
+            host_tools: Some(true),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout:
+            "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128".into(),
+        arch: Arch::X86_64,
+        options: base,
+    }
+}
diff --git a/src/doc/rustc/src/platform-support/slopos.md b/src/doc/rustc/src/platform-support/slopos.md
new file mode 100644
--- /dev/null
+++ b/src/doc/rustc/src/platform-support/slopos.md
@@ -0,0 +1,50 @@
+# `x86_64-unknown-slopos`
+
+**Tier: 3**
+
+SlopOS on x86-64: a framekernel-discipline hobby operating system whose C
+library, `slibc`, is the target's `env`.
+
+## Target maintainers
+
+[@nil0ft](https://github.com/nil0ft)
+
+## Requirements
+
+The target supports `std` and host tools: rustc, cargo and clang cross-built
+for it run on SlopOS. The `std` port is a separate change (see "Building the
+target").
+
+Binaries are ELF and link against `slibc`, which supplies the C library, the
+`pthread` primitives `std` builds its synchronisation on, and the Itanium
+Level-1 unwinder. Both `libc.so` and `libc.a` are available, and
+`/lib/ld-slopos.so.1` is the program interpreter; a `PT_INTERP` executable and
+`dlopen` both work. The baseline is x86-64 with `xsave`, `avx` and `avx2`;
+`mmx` is off.
+
+`extern "C"` is the System V AMD64 calling convention. Panics unwind through
+the unwinder `libc.so` exports. Programs link through `cc`, a clang carrying
+the SlopOS toolchain, which supplies `crt0.o`, the interpreter, `-lc` and
+compiler-rt.
+
+## Building the target
+
+Add `x86_64-unknown-slopos` to the `target` list in `bootstrap.toml`. `std`
+for this target is a separate change: it needs the `target_os = "slopos"` arms
+in `library/`, which ride `sys/pal/unix`, and a `libc` carrying
+`src/unix/slopos/`. Both are cut against the same channel as this spec.
+
+## Building Rust programs
+
+Rust does not ship pre-compiled artifacts for this target. Build `std` with
+`-Zbuild-std`, or build a toolchain with the target enabled.
+
+## Testing
+
+Binaries run on SlopOS, which boots under QEMU with a `q35` machine, an
+IOAPIC and a virtio-blk disk. The Rust testsuite is not run on the target.
+
+## Cross-compilation toolchains and C code
+
+C code is supported. Compile it with `clang --target=x86_64-unknown-slopos
+-nostdlibinc -isystem <slibc>/include` and link against `libc.a` or `libc.so`.
