+#[repr(C)]
+#[derive(Copy, Clone)]
+struct sifields_sigchld {
+    si_pid: crate::pid_t,
+    si_uid: crate::uid_t,
+    si_status: c_int,
+    si_utime: clock_t,
+    si_stime: clock_t,
+}
+
+#[repr(C)]
+#[derive(Copy, Clone)]
+struct sifields_sigfault {
+    si_addr: *mut c_void,
+}
+
+#[repr(C)]
+#[derive(Copy, Clone)]
+union sifields {
+    _align_pointer: *mut c_void,
+    sigchld: sifields_sigchld,
+    sigfault: sifields_sigfault,
+}
+
+impl siginfo_t {
+    /// # Safety
+    ///
+    /// The signal must be one whose `siginfo_t` carries a process id
+    /// (`SIGCHLD`).
+    pub unsafe fn si_pid(&self) -> crate::pid_t {
+        self.sifields().sigchld.si_pid
+    }
+
+    /// # Safety
+    ///
+    /// As [`siginfo_t::si_pid`].
+    pub unsafe fn si_uid(&self) -> crate::uid_t {
+        self.sifields().sigchld.si_uid
+    }
+
+    /// # Safety
+    ///
+    /// As [`siginfo_t::si_pid`].
+    pub unsafe fn si_status(&self) -> c_int {
+        self.sifields().sigchld.si_status
+    }
+
+    /// # Safety
+    ///
+    /// The signal must be a fault signal (`SIGSEGV`, `SIGBUS`, `SIGILL`,
+    /// `SIGFPE`), which are the ones carrying a fault address.
+    pub unsafe fn si_addr(&self) -> *mut c_void {
+        self.sifields().sigfault.si_addr
+    }
+
+    unsafe fn sifields(&self) -> &sifields {
+        &*(((self as *const siginfo_t as usize) + 16) as *const sifields)
+    }
+}
