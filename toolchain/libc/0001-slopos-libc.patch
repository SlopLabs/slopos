+//! SlopOS, over the `slibc` C library.
+//!
+//! * Headers: `slibc/include`
+//! * Kernel ABI: SlopOS's `abi` crate
+//!
+//! SlopOS implements the Linux x86-64 system-call ABI: a call below the target's
+//! private base carries Linux's number and Linux's signature. Every layout here
+//! is therefore Linux's, and is pinned against the kernel's own definition by a
+//! const assert on the SlopOS side.
+
+use crate::iovec;
+use crate::prelude::*;
+
+pub type wchar_t = i32;
+pub type off_t = i64;
+pub type off64_t = i64;
