+f! {
+    pub unsafe fn CMSG_FIRSTHDR(mhdr: *const msghdr) -> *mut cmsghdr {
+        if (*mhdr).msg_controllen >= size_of::<cmsghdr>() {
+            (*mhdr).msg_control as *mut cmsghdr
+        } else {
+            core::ptr::null_mut()
+        }
+    }
+
+    pub unsafe fn CMSG_NXTHDR(mhdr: *const msghdr, cmsg: *const cmsghdr) -> *mut cmsghdr {
+        let len = (*cmsg).cmsg_len;
+        // An over-long `cmsg_len` is refused *before* it is aligned:
+        // `CMSG_ALIGN` wraps to 0 within 7 of `usize::MAX`, which would make
+        // `next == cmsg`, pass the bound test below, and hand the caller back
+        // the header it already holds — an unterminated walk. glibc carries
+        // two bound tests here for the same reason.
+        if len < size_of::<cmsghdr>() || len > (*mhdr).msg_controllen {
+            return core::ptr::null_mut();
+        }
+        let next = cmsg as usize + CMSG_ALIGN(len);
+        let max = (*mhdr).msg_control as usize + (*mhdr).msg_controllen;
+        if next < cmsg as usize || next + size_of::<cmsghdr>() > max {
+            core::ptr::null_mut()
+        } else {
+            next as *mut cmsghdr
+        }
+    }
+
+    pub unsafe fn CMSG_DATA(cmsg: *const cmsghdr) -> *mut c_uchar {
+        cmsg.offset(1) as *mut c_uchar
+    }
+
+    pub const unsafe fn CMSG_ALIGN(len: size_t) -> size_t {
+        (len + size_of::<size_t>() - 1) & !(size_of::<size_t>() - 1)
+    }
+
+    pub const unsafe fn CMSG_SPACE(len: c_uint) -> c_uint {
+        (CMSG_ALIGN(len as size_t) + CMSG_ALIGN(size_of::<cmsghdr>())) as c_uint
+    }
+
+    pub const unsafe fn CMSG_LEN(len: c_uint) -> c_uint {
+        (CMSG_ALIGN(size_of::<cmsghdr>()) + len as size_t) as c_uint
+    }
+
+    pub unsafe fn FD_CLR(fd: c_int, set: *mut fd_set) -> () {
+        let fd = fd as usize;
+        (*set).fds_bits[fd / ULONG_BITS] &= !(1 << (fd % ULONG_BITS));
+    }
+
+    pub unsafe fn FD_ISSET(fd: c_int, set: *const fd_set) -> bool {
+        let fd = fd as usize;
+        (*set).fds_bits[fd / ULONG_BITS] & (1 << (fd % ULONG_BITS)) != 0
+    }
+
+    pub unsafe fn FD_SET(fd: c_int, set: *mut fd_set) -> () {
+        let fd = fd as usize;
+        (*set).fds_bits[fd / ULONG_BITS] |= 1 << (fd % ULONG_BITS);
+    }
+
+    pub unsafe fn FD_ZERO(set: *mut fd_set) -> () {
+        for slot in (*set).fds_bits.iter_mut() {
+            *slot = 0;
+        }
+    }
+}
