+pub type Elf64_Xword = u64;
+pub type jmp_buf = [__jmp_buf_tag; 1];
+pub type sigjmp_buf = [__jmp_buf_tag; 1];
+
+extern_ty! {
+    pub type FILE;
+    pub type __locale_struct;
+}
