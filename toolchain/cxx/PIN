# The SlopOS llvm-project pin.
#
# One tarball serves two consumers. `scripts/make_slopos_cxx.sh` cross-builds
# libc++ and libc++abi for `x86_64-unknown-slopos` out of it and links them
# into one `libc++.so`; `scripts/make_slopos_llvm_src.sh` materialises the
# whole tree with the SlopOS port below applied, which is what
# `scripts/check_llvm_port.sh` compiles LLVM's Support library out of.
# `scripts/check_cxx_pin.sh` fails if any line here stops describing what is
# on disk.
#
# The runtime is LLVM's rather than GCC's because only LLVM's needs no second
# compiler: the host clang that builds it is already here, where libstdc++
# would cost a GCC cross-build first. `plans/self-hosting.md` carries the
# measurement that settled it.
llvm_version=18.1.8
llvm_url=https://github.com/llvm/llvm-project/releases/download/llvmorg-18.1.8/llvm-project-18.1.8.src.tar.xz
llvm_sha256=0b58557a6d32ceee97c8d533a59b9212d87e0fc4d2833924eb6c611247db2f2a
# The host LLVM the runtime is cross-built with. A *floor*, not an equality:
# the pinned sources fix the C++ ABI and the libc symbols `libc++.so` needs,
# and the host compiler only codegens them, so a newer major is accepted while
# an older one is not. Demanding the sources' own major made the tests image
# unbuildable on every rolling distribution — no Linux ships LLVM 18 by
# default any more and Arch packages no versioned llvm18 at all.
#
# `clang_major_tested` is what has actually built a green `just test`; a major
# outside it builds with a note, because the C++ probes on the tests image are
# the functional gate (`cxx_test` throws across a `dlopen` boundary and
# `cxx_static_probe` links the archives), not this line.
clang_major_min=18
clang_major_tested=18 22

# The SlopOS port of llvm-project: the two places LLVM dispatches on the OS
# without a default a new one can take, plus the Triple and clang target that
# make `__slopos__` a macro a cross-built compiler predefines. Upstream-shaped
# and upstream-sized — it is the diff a tier-3 OS port PR carries.
patch_sha256=toolchain/llvm/0001-slopos-support.patch:9027a833fafa9cdeeb4f2268e153498856733f0898a14e9de311e248e01055fb
patch_sha256=toolchain/llvm/0002-slopos-clang-driver.patch:4da079ce1261670ce1f56acfd88f59a83a208b85dabbc0c8d1f556b950f83ef4
