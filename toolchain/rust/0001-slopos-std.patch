diff --git a/std/src/sys/random/slopos.rs b/std/src/sys/random/slopos.rs
new file mode 100644
index 0000000..71a122e
--- /dev/null
+++ b/std/src/sys/random/slopos.rs
@@ -0,0 +1,16 @@
+pub fn fill_bytes(bytes: &mut [u8]) {
+    let mut filled = 0;
+    while filled < bytes.len() {
+        let rest = &mut bytes[filled..];
+        // SAFETY: `rest` is a valid, writable slice of `rest.len()` bytes.
+        let ret = unsafe { libc::getrandom(rest.as_mut_ptr().cast(), rest.len(), 0) };
+        if ret < 0 {
+            // SlopOS's pool is always seeded, so the only failure a correct
+            // call can see is an interrupting signal.
+            let err = unsafe { *libc::__errno_location() };
+            assert_eq!(err, libc::EINTR, "failed to generate random data");
+        } else {
+            filled += ret as usize;
+        }
+    }
+}
