# Mbed TLS: libcurl's TLS, so git's HTTPS transport and cargo's registry
# traffic. `Apache-2.0 OR GPL-2.0-or-later` is what lets git, GPL-2.0-only,
# link it, where OpenSSL 3's Apache-2.0 alone would not.
#
# 4.1, the long-term-support branch. The tarball carries TF-PSA-Crypto, which
# builds libtfpsacrypto. The default configuration compiles out the
# Apache-2.0-only Project Everest code it bundles, and leaves out
# MBEDTLS_THREADING_C, so a process drives TLS from one thread, as git and
# cargo do.
#
#   ENABLE_TESTING    the suites, generated by the host's Python.
#   ENABLE_PROGRAMS   the sample clients and servers.
version=4.1.1
url=https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-4.1.1/mbedtls-4.1.1.tar.bz2
sha256=3359a349e23db3d5536fcee032ae7b2ecbfc08972fab643089b5cbf2a375c98c
license=Apache-2.0 OR GPL-2.0-or-later
license_file=LICENSE
license_file=tf-psa-crypto/LICENSE
template=cmake
soname=libtfpsacrypto.so.2
soname=libmbedx509.so.9
soname=libmbedtls.so.23
arg=-DUSE_SHARED_MBEDTLS_LIBRARY=ON
arg=-DUSE_STATIC_MBEDTLS_LIBRARY=OFF
arg=-DENABLE_TESTING=OFF
arg=-DENABLE_PROGRAMS=OFF
