# OpenSSL 3: TLS for libgit2, and the cryptography libssh2 and openssl-sys
# build on.
#
# `Configure --config=slopos.conf` is how Configure admits a platform it does
# not ship.
#
#   /etc/ssl    where the SlopOS image keeps its CA bundle.
version=3.6.4
url=https://github.com/openssl/openssl/releases/download/openssl-3.6.4/openssl-3.6.4.tar.gz
sha256=9bffaa1ad1e07b354c21bd3324ec02fa15579f45a7d0494b3e74bc449b7333ef
license=Apache-2.0
license_file=LICENSE.txt
template=openssl
config=slopos.conf
target=slopos-x86_64
soname=libcrypto.so.3
soname=libssl.so.3
arg=--openssldir=/etc/ssl
arg=no-tests
