# libcurl: git's HTTP transport (git-remote-https) and cargo's registry
# client. The library only — SlopOS ships its own `/bin/curl`.
#
#   CURL_USE_MBEDTLS               TLS that git, GPL-2.0-only, may link;
#                                  OpenSSL is in the prefix for libgit2 and
#                                  libssh2, so it is switched off by name.
#   CURL_USE_LIBPSL, USE_LIBIDN2   the public-suffix list and IDN, two more
#                                  libraries cargo's registries do not need.
#   CURL_USE_LIBSSH2               SCP and SFTP URLs; cargo's ssh is
#                                  libgit2's, not curl's.
#   CURL_CA_BUNDLE                 the SlopOS image's CA bundle.
#   CURL_LIBCURL_SOVERSION         `libcurl.so.4`, which curl names only for
#                                  the systems it lists.
version=8.22.0
url=https://curl.se/download/curl-8.22.0.tar.xz
sha256=f7ef3ae8a22e521f289803fe93543eb64c329b58aa73a9e224dfd915a2a5f4f7
license=curl
license_file=COPYING
template=cmake
depends=mbedtls nghttp2 zlib
soname=libcurl.so.4
arg=-DBUILD_CURL_EXE=OFF
arg=-DCURL_LIBCURL_SOVERSION=ON
arg=-DBUILD_STATIC_LIBS=OFF
arg=-DBUILD_TESTING=OFF
arg=-DBUILD_LIBCURL_DOCS=OFF
arg=-DBUILD_MISC_DOCS=OFF
arg=-DENABLE_CURL_MANUAL=OFF
arg=-DCURL_USE_MBEDTLS=ON
arg=-DCURL_USE_OPENSSL=OFF
arg=-DUSE_NGHTTP2=ON
arg=-DCMAKE_REQUIRE_FIND_PACKAGE_NGHTTP2=ON
arg=-DCURL_ZLIB=ON
arg=-DCURL_USE_LIBPSL=OFF
arg=-DUSE_LIBIDN2=OFF
arg=-DCURL_USE_LIBSSH2=OFF
arg=-DCURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
arg=-DCURL_CA_PATH=none
