# libssh2: SSH transport for libgit2 (cargo enables git2's `ssh`).
#
# The library only; the examples and the test suite run on the build machine.
version=1.11.1
url=https://libssh2.org/download/libssh2-1.11.1.tar.xz
sha256=9954cb54c4f548198a7cbebad248bdc87dd64bd26185708a294b2b50771e3769
license=BSD-3-Clause
template=cmake
depends=openssl zlib
soname=libssh2.so.1
arg=-DCRYPTO_BACKEND=OpenSSL
arg=-DENABLE_ZLIB_COMPRESSION=ON
arg=-DBUILD_STATIC_LIBS=OFF
arg=-DBUILD_EXAMPLES=OFF
arg=-DBUILD_TESTING=OFF
