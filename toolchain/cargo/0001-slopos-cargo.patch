new file mode 100644
index 0000000..08acf23
--- /dev/null
+++ b/src/sources/unavailable.rs
@@ -0,0 +1,88 @@
+//! A [`Source`] for a [`SourceId`] this build of cargo cannot reach.
+//!
+//! Without the `network` feature there is no registry client and no git
+//! implementation, but a replaced source is still *loaded*: source replacement
+//! asks the original whether it checksums and whether it needs a precise
+//! version before wrapping the replacement. Those two answers are constants of
+//! the source kind, so a vendored build is served by a source that answers
+//! them and refuses everything else.
+
+use crate::sources::source::MaybePackage;
+use crate::sources::source::QueryKind;
+use crate::sources::source::Source;
+use crate::sources::IndexSummary;
+use crate::util::CargoResult;
+use crate::util::errors::no_network;
+use crate::workspace::{Dependency, Package, PackageId, SourceId};
+
+pub struct UnavailableSource {
+    source_id: SourceId,
+    supports_checksums: bool,
+    requires_precise: bool,
+}
+
+impl UnavailableSource {
+    pub fn registry(source_id: SourceId) -> UnavailableSource {
+        UnavailableSource {
+            source_id,
+            supports_checksums: true,
+            requires_precise: false,
+        }
+    }
+
+    pub fn git(source_id: SourceId) -> UnavailableSource {
+        UnavailableSource {
+            source_id,
+            supports_checksums: false,
+            requires_precise: true,
+        }
+    }
+
+    fn refuse<T>(&self) -> CargoResult<T> {
+        Err(no_network(format_args!("{}", self.source_id)))
+    }
+}
+
+#[async_trait::async_trait(?Send)]
+impl Source for UnavailableSource {
+    fn source_id(&self) -> SourceId {
+        self.source_id
+    }
+
+    fn supports_checksums(&self) -> bool {
+        self.supports_checksums
+    }
+
+    fn requires_precise(&self) -> bool {
+        self.requires_precise
+    }
+
+    async fn query(
+        &self,
+        _dep: &Dependency,
+        _kind: QueryKind,
+        _f: &mut dyn FnMut(IndexSummary),
+    ) -> CargoResult<()> {
+        self.refuse()
+    }
+
+    fn invalidate_cache(&self) {}
+
+    fn set_quiet(&mut self, _quiet: bool) {}
+
+    async fn download(&self, _package: PackageId) -> CargoResult<MaybePackage> {
+        self.refuse()
+    }
+
+    async fn finish_download(&self, _id: PackageId, _contents: Vec<u8>) -> CargoResult<Package> {
+        self.refuse()
+    }
+
+    fn fingerprint(&self, _pkg: &Package) -> CargoResult<String> {
+        self.refuse()
+    }
+
+    fn describe(&self) -> String {
+        format!("{}", self.source_id)
+    }
+}
