  program  /bin/cpufreq
  args     set *
  caps     Power
  uid      0
  allow    root
  allow    session
  allow    paired
  describe "Change how fast the CPUs run and where tasks go"

action org.slopos.kconsole
  program  /bin/kconsole
  args     *
  caps     SysInspect
  uid      0
  allow    root
  allow    session
  allow    paired
  describe "Run the diagnostic console's informational commands"

action org.slopos.prof
  program  /bin/prof
  args     *
  caps     SysInspect
  uid      0
  allow    root
  allow    session
  allow    paired
  describe "Start, stop or report the kernel's sampling profiler"

action org.slopos.console.keymap
