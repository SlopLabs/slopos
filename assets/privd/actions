# The actions /sbin/privd runs. In the sealed base at
# /usr/share/slopos/privd/actions; the grammar is slopos_priv_core::policy's.
#
# Every mechanism runs as uid 0 with no more than its action names. Whoever
# privd may ask about an action is listed in order, and the first line whose
# principal matches the requester decides.

action org.slopos.power.poweroff
  program  /bin/halt
  args     halt
  args     poweroff
  args     shutdown
  caps     Power
  uid      0
  allow    root
  allow    session
  allow    paired
  describe "Power off the machine"

action org.slopos.power.reboot
  program  /bin/halt
  args     reboot
  caps     Power
  uid      0
  allow    root
  allow    session
  allow    paired
  describe "Restart the machine"

action org.slopos.boot.status
  program  /bin/bootctl
  args     status
  caps     RawBlock Power
  uid      0
  allow    root
  allow    session
  allow    paired
  describe "Show what each boot slot and base holds and what boots"

action org.slopos.boot.install
  program  /bin/bootctl
  args     install *
  caps     RawBlock Power
  uid      0
  cwd
  exclusive boot-slots
  allow    root
  allow    session consent
  allow    paired
  describe "Install a kernel into a boot slot"

action org.slopos.boot.clone
  program  /bin/bootctl
  args     clone *
  caps     RawBlock Power
  uid      0
  exclusive boot-slots
  allow    root
  allow    session consent
  allow    paired
  describe "Copy one boot slot's kernel into another"

action org.slopos.base.install
  program  /bin/bootctl
  args     base install *
  caps     RawBlock Power BaseUpdate
  uid      0
  cwd
  exclusive boot-slots
  allow    root
  allow    session consent
  allow    paired
  describe "Replace the base every boot slot boots, and the one running now"

action org.slopos.base.rollback
  program  /bin/bootctl
  args     base rollback
  caps     RawBlock Power BaseUpdate
  uid      0
  exclusive boot-slots
  allow    root
  allow    session consent
  allow    paired
  describe "Go back to the base that ran before, now"

action org.slopos.boot.oneshot
  program  /bin/bootctl
  args     oneshot *
  caps     Power
  uid      0
  exclusive boot-slots
  allow    root
  allow    session
  allow    paired
  describe "Boot an entry once, on the next restart"

action org.slopos.boot.set-default
  program  /bin/bootctl
  args     set-default *
  caps     RawBlock Power
  uid      0
  exclusive boot-slots
  allow    root
  allow    session consent
  allow    paired
  describe "Change which boot entry starts by default"

action org.slopos.boot.commit
  program  /bin/bootctl
  args     commit
  caps     Power
  uid      0
  exclusive boot-slots
  allow    root
  allow    session
  allow    paired
  describe "Keep the system that booted as the default"

action org.slopos.boot.spare
  program  /bin/bootctl
  args     spare
  caps     Power
  uid      0
  allow    root
  allow    session
  allow    paired
  describe "Name the boot slot a new system goes into"

action org.slopos.boot.reboot
  program  /bin/bootctl
  args     reboot
  caps     Power
  uid      0
  allow    root
  allow    session
  allow    paired
  describe "Restart the machine"

action org.slopos.extension.install
  program  /bin/extctl
  args     install *
  caps     ExtensionUpdate Seal
  uid      0
  cwd
  exclusive extensions
  allow    root
  allow    session consent
  allow    paired
  describe "Install an extension, granting it what the command names; RawBlock, Mount or DacOverride gives it the machine"

action org.slopos.extension.install-signed
  program  /bin/extctl
  args     install-signed *
  caps     ExtensionUpdate Seal
  uid      0
  cwd
  exclusive extensions
  allow    root
  allow    session
  allow    paired
  describe "Install or update an extension signed by a trusted key, within that key's ceilings"

action org.slopos.extension.trust
  program  /bin/extctl
  args     key add *
  args     key remove *
  caps     ExtensionUpdate Seal
  uid      0
  exclusive extensions
  allow    root
  allow    session consent
  allow    paired
  describe "Trust a key to install extensions within the ceilings named; RawBlock, Mount or DacOverride is the machine"

action org.slopos.extension.manage
  program  /bin/extctl
  args     enable *
  args     disable *
  args     remove *
  args     rollback *
  caps     ExtensionUpdate Seal
  uid      0
  exclusive extensions
  allow    root
  allow    session consent
  allow    paired
  describe "Turn an extension on or off, remove it, or go back to the version it had before"

action org.slopos.extension.config
  program  /bin/extctl
  args     config install *
  caps     Seal
  uid      0
  cwd
  exclusive extensions
  allow    root
  allow    session consent
  allow    paired
  describe "Install a file of an extension's configuration in /etc, which restarts what reads it"

action org.slopos.extension.config-signed
  program  /bin/extctl
  args     config apply *
  caps     Seal
  uid      0
  cwd
  exclusive extensions
  allow    root
  allow    session
  allow    paired
  describe "Install an extension's configuration signed by the key that installed it"

