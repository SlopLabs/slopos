action org.slopos.net.toggle
  program  /bin/ip
  args     net on
  args     net off
  caps     NetAdmin
  uid      0
  allow    root
  allow    program /bin/compositor
  allow    session consent
  describe "Turn networking on or off"

action org.slopos.net.configure
  program  /bin/ip
  args     *
  caps     NetAdmin
  uid      0
  allow    root
  allow    session consent
  describe "Change the network configuration"

action org.slopos.install
  program  /bin/installer
  args     *
  caps     RawBlock Mount Power BootEntry Seal DacOverride
  uid      0
  exclusive
  allow    root
  allow    session consent
  describe "Install SlopOS onto whichever disk the requester names, erasing what it says to"

action org.slopos.rescue
  program  /bin/shell
  args     --rescue
  caps     Power Mount RawBlock NetAdmin ConsoleConfig SysInspect Clock Seal BootEntry DacOverride BaseUpdate ExtensionUpdate
  uid      0
  medium
  allow    root
  allow    session consent
  describe "Open a rescue shell holding everything privd can give, which can read and change every disk"
