# slopos layout v1 — UK English (QWERTY)
#
#   key <KEY_NAME> <caps:yes|no> <base> <shift> <altgr> <shift+altgr>
# As on a UK keyboard (XKB gb): Shift+2 types ", Shift+3 £, the key beside
# Enter # and ~, and the key beside the left Shift \ and |. AltGr+4 types €.

name = gb
title = UK English (QWERTY)

# Number row.
key KEY_GRAVE  no  grave  notsign     brokenbar  -
key KEY_1      no  1      exclam      -          -
key KEY_2      no  2      dquote      -          -
key KEY_3      no  3      sterling    -          -
key KEY_4      no  4      dollar      euro       -
key KEY_5      no  5      percent     -          -
key KEY_6      no  6      asciicircum -          -
key KEY_7      no  7      ampersand   -          -
key KEY_8      no  8      asterisk    -          -
key KEY_9      no  9      parenleft   -          -
key KEY_0      no  0      parenright  -          -
key KEY_MINUS  no  minus  underscore  -          -
key KEY_EQUAL  no  equal  plus        -          -

# Top row.
key KEY_Q  yes  q  Q  -  -
key KEY_W  yes  w  W  -  -
key KEY_E  yes  e  E  eacute  Eacute
key KEY_R  yes  r  R  -  -
key KEY_T  yes  t  T  -  -
key KEY_Y  yes  y  Y  -  -
key KEY_U  yes  u  U  uacute  -
key KEY_I  yes  i  I  iacute  -
key KEY_O  yes  o  O  oacute  -
key KEY_P  yes  p  P  -  -
key KEY_LEFTBRACE   no  bracketleft   braceleft   -  -
key KEY_RIGHTBRACE  no  bracketright  braceright  -  -

# Home row.
key KEY_A  yes  a  A  aacute  Aacute
key KEY_S  yes  s  S  -  -
key KEY_D  yes  d  D  -  -
key KEY_F  yes  f  F  -  -
key KEY_G  yes  g  G  -  -
key KEY_H  yes  h  H  -  -
key KEY_J  yes  j  J  -  -
key KEY_K  yes  k  K  -  -
key KEY_L  yes  l  L  -  -
key KEY_SEMICOLON   no  semicolon   colon       -  -
key KEY_APOSTROPHE  no  apostrophe  at          -  -
key KEY_NONUS_HASH  no  numbersign  asciitilde  -  -
key KEY_BACKSLASH   no  numbersign  asciitilde  -  -

# Bottom row.
key KEY_NONUS_BACKSLASH  no  backslash  bar  -  -
key KEY_Z  yes  z  Z  -  -
key KEY_X  yes  x  X  -  -
key KEY_C  yes  c  C  -  -
key KEY_V  yes  v  V  -  -
key KEY_B  yes  b  B  -  -
key KEY_N  yes  n  N  -  -
key KEY_M  yes  m  M  -  -
key KEY_COMMA  no  comma   less     -  -
key KEY_DOT    no  period  greater  -  -
key KEY_SLASH  no  slash   question -  -
