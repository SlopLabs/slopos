+// SlopOS diagnostics, autoboot-as-editor build: what pressing e and then F10
+// with nothing changed does that Enter, the timeout and a one-shot boot do not:
+// keep a copy of the entry in an editor-sized buffer and boot from it, and
+// allocate and free the editor's cell map. Their allocations then land where
+// an edited boot's do. The caller drains the pointers, as the editor's does.
+// SLOPOS_DIAG_MIMIC_NO_ALLOC or _NO_FLUSH leaves out one half, to tell which
+// of the two an edited boot needs.
+#if !defined (SLOPOS_DIAG_MIMIC_NO_ALLOC)
+static char *autoboot_as_editor(const char *title, const char *orig_entry) {
+    size_t entry_size = strlen(orig_entry);
+    while (*orig_entry == '\n') {
+        orig_entry++;
+        entry_size--;
+    }
+    if (entry_size >= EDITOR_MAX_BUFFER_SIZE) {
+        return NULL;
+    }
+
+    char *buffer = ext_mem_alloc(EDITOR_MAX_BUFFER_SIZE);
+    memcpy(buffer, orig_entry, entry_size);
+    buffer[entry_size] = 0;
+
+    size_t cell_map_size = terms[0]->cols * terms[0]->rows * sizeof(size_t);
+    size_t *cell_map = ext_mem_alloc(cell_map_size);
+    memset(cell_map, 0xff, cell_map_size);
+
+    memcpy(saved_orig_entry, buffer, entry_size);
+    saved_orig_entry[entry_size] = 0;
+    size_t title_len = strlen(title);
+    if (title_len >= sizeof(saved_title)) {
+        title_len = sizeof(saved_title) - 4;
+        memcpy(saved_title, title, title_len);
+        memcpy(saved_title + title_len, "...", 4);
+    } else {
+        memcpy(saved_title, title, title_len);
+        saved_title[title_len] = 0;
+    }
+    pmm_free(cell_map, cell_map_size);
+    booting_from_editor = true;
+    return buffer;
+}
+#endif
