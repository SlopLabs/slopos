+    uint32_t line_colour[SD_MAX_LINES];
+    char report[20][SD_LINE_MAX];
+};
+
+static struct sd_big *sd;
+
+static void sd_flush(void) {
+    asm volatile ("sfence; lock orq $0, (%%rsp)" ::: "memory");
+}
+
+static uint32_t sd_channel(uint32_t v8, uint8_t size, uint8_t shift) {
+    uint32_t v = size >= 8 ? v8 << (size - 8) : v8 >> (8 - size);
+    return v << shift;
+}
+
+static uint32_t sd_px(uint32_t rgb) {
+    return sd_channel((rgb >> 16) & 0xff, sd_rsz, sd_rsh)
+         | sd_channel((rgb >> 8) & 0xff, sd_gsz, sd_gsh)
+         | sd_channel(rgb & 0xff, sd_bsz, sd_bsh);
+}
+
+static void sd_fill(uint64_t x, uint64_t y, uint64_t w, uint64_t h, uint32_t rgb) {
+    if (x >= sd_w || y >= sd_h) {
+        return;
+    }
+    if (w > sd_w - x) {
+        w = sd_w - x;
+    }
+    if (h > sd_h - y) {
+        h = sd_h - y;
+    }
+    uint32_t c = sd_px(rgb);
+    for (uint64_t yy = y; yy < y + h; yy++) {
+        volatile uint32_t *row = sd_fb + yy * sd_pitch;
+        for (uint64_t xx = x; xx < x + w; xx++) {
+            row[xx] = c;
+        }
+    }
+}
+
+static const uint8_t *sd_glyph(char ch) {
+    if (ch >= 'a' && ch <= 'z') {
+        ch -= 'a' - 'A';
+    }
+    if (ch < ' ' || ch - ' ' >= 96) {
+        return sd_font['?' - ' '];
+    }
+    const uint8_t *g = sd_font[ch - ' '];
+    if (ch != ' ' && (g[0] | g[1] | g[2] | g[3] | g[4] | g[5] | g[6]) == 0) {
+        return sd_font['?' - ' '];
+    }
+    return g;
+}
+
+static void sd_char(uint64_t x, uint64_t y, char ch, uint32_t fg_rgb, uint32_t bg_rgb) {
+    const uint8_t *g = sd_glyph(ch);
+    uint32_t fg = sd_px(fg_rgb), bg = sd_px(bg_rgb);
+    for (unsigned r = 0; r < 9; r++) {
+        uint8_t bits = r < 7 ? g[r] : 0;
+        for (unsigned sy = 0; sy < sd_s; sy++) {
+            uint64_t yy = y + r * sd_s + sy;
+            if (yy >= sd_h) {
+                return;
+            }
+            volatile uint32_t *row = sd_fb + yy * sd_pitch;
+            for (unsigned c = 0; c < 6; c++) {
+                uint32_t v = (c < 5 && (bits & (0x10 >> c))) ? fg : bg;
+                for (unsigned sx = 0; sx < sd_s; sx++) {
+                    uint64_t xx = x + c * sd_s + sx;
+                    if (xx < sd_w) {
+                        row[xx] = v;
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void sd_text(uint64_t x, uint64_t y, const char *s, unsigned width,
+                    uint32_t fg, uint32_t bg) {
+    for (unsigned i = 0; i < width; i++) {
+        sd_char(x + (uint64_t)i * sd_cw, y, *s ? *s++ : ' ', fg, bg);
+    }
+}
+
+struct sd_buf {
+    char *p;
+    size_t n;
+    size_t i;
+};
+
+static void sd_putc(struct sd_buf *b, char c) {
+    if (b->i + 1 < b->n) {
+        b->p[b->i++] = c;
+        b->p[b->i] = 0;
+    }
+}
+
+static void sd_puts(struct sd_buf *b, const char *s) {
+    while (s != NULL && *s) {
+        sd_putc(b, *s++);
+    }
+}
+
+static void sd_putx(struct sd_buf *b, uint64_t v, int digits) {
+    static const char hex[] = "0123456789ABCDEF";
+    char t[16];
+    int n = 0;
+    do {
+        t[n++] = hex[v & 0xf];
+        v >>= 4;
+    } while (v != 0 && n < 16);
+    while (n < digits) {
+        t[n++] = '0';
+    }
+    while (n > 0) {
+        sd_putc(b, t[--n]);
+    }
+}
+
+static void sd_putu(struct sd_buf *b, uint64_t v) {
+    char t[20];
+    int n = 0;
+    do {
+        t[n++] = '0' + v % 10;
+        v /= 10;
+    } while (v != 0);
+    while (n > 0) {
+        sd_putc(b, t[--n]);
+    }
+}
+
+static const char *sd_status_name(uint64_t st) {
+    switch (st) {
+        case 0: return "OK";
+        case 0x8000000000000002ULL: return "INVALID_PARAMETER";
+        case 0x8000000000000003ULL: return "UNSUPPORTED";
+        case 0x8000000000000005ULL: return "BUFFER_TOO_SMALL";
+        case 0x8000000000000009ULL: return "OUT_OF_RESOURCES";
+        case 0x8000000000000012ULL: return "TIMEOUT";
+        default: return NULL;
+    }
+}
+
+// %x and %X take uint64_t (X zero-pads to 16 digits), %u uint64_t, %s a
+// string, %E an EFI_STATUS, which prints its name when it has a common one.
+static void sd_vfmt(struct sd_buf *b, const char *fmt, va_list ap) {
+    for (; *fmt; fmt++) {
+        if (*fmt != '%') {
+            sd_putc(b, *fmt);
+            continue;
+        }
+        switch (*++fmt) {
+            case 'x': sd_putx(b, va_arg(ap, uint64_t), 1); break;
+            case 'X': sd_putx(b, va_arg(ap, uint64_t), 16); break;
+            case 'u': sd_putu(b, va_arg(ap, uint64_t)); break;
+            case 's': sd_puts(b, va_arg(ap, const char *)); break;
+            case 'E': {
+                uint64_t st = va_arg(ap, uint64_t);
+                const char *name = sd_status_name(st);
+                if (name != NULL) {
+                    sd_puts(b, name);
+                } else {
+                    sd_putx(b, st, 1);
+                }
+                break;
+            }
+            case 0: return;
+            default: sd_putc(b, *fmt); break;
+        }
+    }
+}
+
+static void sd_fmt(char *out, size_t n, const char *fmt, ...) {
+    struct sd_buf b = { out, n, 0 };
+    out[0] = 0;
+    va_list ap;
+    va_start(ap, fmt);
+    sd_vfmt(&b, fmt, ap);
+    va_end(ap);
+}
+
+// QEMU's debugcon: every allocation from boot() on, to compare two paths'
+// layouts under an emulator.
+#ifdef SLOPOS_DIAG_E9_TRACE
+static void sd_e9(const char *fmt, ...) {
+    char buf[96];
+    struct sd_buf b = { buf, sizeof(buf), 0 };
+    buf[0] = 0;
+    va_list ap;
+    va_start(ap, fmt);
+    sd_vfmt(&b, fmt, ap);
+    va_end(ap);
+    for (size_t i = 0; i < b.i; i++) {
+        outb(0xe9, (uint8_t)buf[i]);
+    }
+}
+#else
+#define sd_e9(...) do { } while (0)
+#endif
+
+static size_t sd_strlen(const char *s) {
+    size_t n = 0;
+    while (s[n]) {
+        n++;
+    }
+    return n;
+}
+
+static void sd_line_xy(unsigned i, uint64_t *x, uint64_t *y) {
+    unsigned col = i / sd_rows, row = i % sd_rows;
+    if (col > 1) {
+        col = 1;
+        row = sd_rows - 1;
+    }
+    *x = col == 0 ? sd_x0 : sd_half;
+    *y = sd_trail_y + (uint64_t)row * sd_lh;
+}
+
+static void sd_draw_line(unsigned i, bool newest) {
+    uint64_t x, y;
+    sd_line_xy(i, &x, &y);
+    sd_char(x, y, newest ? '>' : ' ', SD_YELLOW, SD_BLACK);
+    sd_text(x + sd_cw, y, sd->lines[i], sd_col_chars - 1,
+            newest ? SD_YELLOW : sd->line_colour[i], SD_BLACK);
+    sd_flush();
+}
+
+static unsigned sd_new_line(uint32_t colour) {
+    unsigned i = sd_nlines < SD_MAX_LINES ? sd_nlines++ : SD_MAX_LINES - 1;
+    if (sd_nlines > 1 && i != sd_cur) {
+        sd_draw_line(sd_cur, false);
+    }
+    sd_cur = i;
+    sd->line_colour[i] = colour;
+    sd->lines[i][0] = 0;
+    return i;
+}
+
+#ifdef SLOPOS_DIAG_TEST_FAULT
+static void sd_test_fault(void) {
+    *(volatile uint64_t *)(uintptr_t)0x8000000000000000ULL = 0x5d1a6;
+}
+#endif
+
+static void sd_reflow(void);
+
+static void sd_vstep(int kind, const char *fmt, va_list ap) {
+    unsigned i = sd_new_line(kind == SDIAG_CHECK ? SD_GREEN : SD_WHITE);
+    struct sd_buf b = { sd->lines[i], SD_LINE_MAX, 0 };
+    sd_step_line = i;
+    sd_nsteps++;
+    if (sd_nsteps < 10) {
+        sd_putc(&b, '0');
+    }
+    sd_putu(&b, sd_nsteps);
+    sd_putc(&b, ' ');
+    sd_vfmt(&b, fmt, ap);
+    sd_reflow();
+#ifdef SLOPOS_DIAG_TEST_FAULT
+    if (kind == SLOPOS_DIAG_TEST_FAULT && kind != SDIAG_SPINUP) {
+        sd_test_fault();
+    }
+#endif
+}
+
+void sdiag_step(int kind, const char *fmt, ...) {
+    if (!sd_on || sd_in_fault) {
+        return;
+    }
+    va_list ap;
+    va_start(ap, fmt);
+    sd_vstep(kind, fmt, ap);
+    va_end(ap);
+}
+
+// Text past the column would be clipped on screen, so carry it onto
+// continuation lines, breaking at a space where there is one.
+static void sd_reflow(void) {
+    while (sd_strlen(sd->lines[sd_cur]) > sd_col_chars - 1) {
+        char *t = sd->lines[sd_cur];
+        size_t cut = sd_col_chars - 1;
+        while (cut > 8 && t[cut] != ' ') {
+            cut--;
+        }
+        if (cut <= 8) {
+            cut = sd_col_chars - 1;
+        }
+        char rest[SD_LINE_MAX];
+        size_t r = 0, k = cut;
+        while (t[k] == ' ') {
+            k++;
+        }
+        while (t[k] && r + 1 < sizeof(rest)) {
+            rest[r++] = t[k++];
+        }
+        rest[r] = 0;
+        t[cut] = 0;
+        unsigned i = sd_new_line(sd->line_colour[sd_cur]);
+        struct sd_buf nb = { sd->lines[i], SD_LINE_MAX, 0 };
+        sd_puts(&nb, "   ");
+        sd_puts(&nb, rest);
+    }
+    sd_draw_line(sd_cur, true);
+}
+
+void sdiag_note(const char *fmt, ...) {
+    if (!sd_on || sd_in_fault || sd_nlines == 0) {
+        return;
+    }
+    struct sd_buf b = { sd->lines[sd_cur], SD_LINE_MAX, sd_strlen(sd->lines[sd_cur]) };
+    va_list ap;
+    va_start(ap, fmt);
+    sd_vfmt(&b, fmt, ap);
+    va_end(ap);
+    sd_reflow();
+}
+
+// Appends without redrawing the line, so it costs one small square: used
+// between GetMemoryMap and ExitBootServices, where a long draw would widen the
+// window in which the firmware can invalidate the map key.
+void sdiag_note_quiet(const char *fmt, ...) {
+    if (!sd_on || sd_in_fault || sd_nlines == 0) {
+        return;
+    }
+    size_t len = sd_strlen(sd->lines[sd_cur]);
+    struct sd_buf b = { sd->lines[sd_cur], SD_LINE_MAX, len };
+    va_list ap;
+    va_start(ap, fmt);
+    sd_vfmt(&b, fmt, ap);
+    va_end(ap);
+    uint64_t x, y;
+    sd_line_xy(sd_cur, &x, &y);
+    if (len + 2 < sd_col_chars) {
+        sd_fill(x + (len + 2) * (uint64_t)sd_cw, y + sd_s, 4 * (uint64_t)sd_s, 4 * (uint64_t)sd_s, SD_YELLOW);
+        sd_flush();
+    }
+}
+
+static void sd_header(void) {
+    char l[4][SD_LINE_MAX];
+    uint64_t slide = (uint64_t)(uintptr_t)__slide;
+    uint64_t img = ((uintptr_t)__image_end - (uintptr_t)__image_base + 4095) / 4096;
+    sd_fmt(l[0], SD_LINE_MAX, "SLOPOS LIMINE-DIAG %s %s   GREEN BOX TOP RIGHT = LIMINE JUMPED TO THE KERNEL",
+           LIMINE_VERSION, SDIAG_VARIANT);
+    sd_fmt(l[1], SD_LINE_MAX, "ENTRY EDITOR=%u MIMIC=%u  POINTER INITS=%u REL=%u ABS=%u GETSTATE=%u FLUSH=%u  FB %ux%u",
+           (uint64_t)booting_from_editor, (uint64_t)sdiag_mimic_ran, (uint64_t)sd_ptr_inits,
+           (uint64_t)sd_ptr_rel, (uint64_t)sd_ptr_abs, (uint64_t)sd_getstates, (uint64_t)sd_flushes,
+           sd_w, sd_h);
+    sd_fmt(l[2], SD_LINE_MAX, "SLIDE=%x ABOVE4G=%u  KBASE=%x  STACK=%x  FW-CR3=%x",
+           slide, (uint64_t)(slide >= 0x100000000ULL), sd_kbase, sd_stack_top, sd_fw_cr3);
+#if defined (SLOPOS_DIAG_STOCK_IMAGE_SIZE)
+    uint64_t stock = ((uint64_t)(SLOPOS_DIAG_STOCK_IMAGE_SIZE) + 4095) / 4096;
+    sd_fmt(l[3], SD_LINE_MAX, "IMAGE %u PAGES, STOCK %u: %s   COUNTS DECIMAL, REST HEX", img, stock,
+           img == stock ? "SAME SIZE, SO STOCK'S MEMORY LAYOUT" : "SIZE DIFFERS, LAYOUT SHIFTED");
+#else
+    sd_fmt(l[3], SD_LINE_MAX, "IMAGE %u PAGES, STOCK SIZE NOT GIVEN   COUNTS DECIMAL, REST HEX", img);
+#endif
+    // The first line stops short of the jump marker in the top right corner.
+    unsigned first = sd_cols_full > 16 ? sd_cols_full - (12 * sd_s + 16) / sd_cw - 1 : sd_cols_full;
+    for (int i = 0; i < 4; i++) {
+        sd_text(sd_x0, sd_y0 + (uint64_t)i * sd_lh, l[i], i == 0 ? first : sd_cols_full, SD_CYAN, SD_BLACK);
+    }
+    sd_flush();
+}
+
+static void sd_set_gate(struct idt_entry *g, uint64_t handler, uint16_t sel) {
+    g->offset_lo = (uint16_t)handler;
+    g->selector = sel;
+    g->ist = 0;
+    g->type_attr = 0x8e;
+    g->offset_mid = (uint16_t)(handler >> 16);
+    g->offset_hi = (uint32_t)(handler >> 32);
+    g->reserved = 0;
+}
+
+static void sd_install_idt(void) {
+    struct sd_idtr cur;
+    uint16_t cs;
+    asm volatile ("sidt %0" : "=m"(cur) :: "memory");
+    asm volatile ("mov %%cs, %0" : "=r"(cs));
+
+    struct idt_entry *fw = (struct idt_entry *)(uintptr_t)cur.base;
+    size_t fw_n = ((size_t)cur.limit + 1) / sizeof(struct idt_entry);
+
+    for (size_t i = 0; i < 256; i++) {
+        if (i < 32) {
+            sd_set_gate(&sd->idt_fw[i], sdiag_stubs[i], cs);
+            sd_set_gate(&sd->idt_handoff[i], sdiag_stubs[i], 0x28);
+            continue;
+        }
+        // Boot services still take their timer and device interrupts here.
+        if (cur.base != 0 && i < fw_n) {
+            sd->idt_fw[i] = fw[i];
+        }
+    }
+
+    struct idt_entry *flush = sdiag_flush_idt();
+    if (flush != NULL) {
+        for (size_t i = 0; i < 32; i++) {
+            sd_set_gate(&flush[i], sdiag_stubs[i], 0x28);
+        }
+    }
+
+    sdiag_idtr_spinup.limit = sizeof(sd->idt_handoff) - 1;
+    sdiag_idtr_spinup.base = (uint64_t)(uintptr_t)sd->idt_handoff;
+
+    struct sd_idtr n = { sizeof(sd->idt_fw) - 1, (uint64_t)(uintptr_t)sd->idt_fw };
+    asm volatile ("lidt %0" :: "m"(n) : "memory");
+}
+
+static struct sd_rec *sd_find(uint64_t addr) {
+    for (unsigned i = 0; i < sd_nrecs; i++) {
+        if (addr >= sd->recs[i].base && addr - sd->recs[i].base < sd->recs[i].len) {
+            return &sd->recs[i];
+        }
+    }
+    return NULL;
+}
+
+static struct sd_rec *sd_add(uint64_t base, uint64_t len, uint64_t req, uint32_t caller) {
+    if (sd_nrecs == SD_MAX_RECS) {
+        sd_dropped++;
+        return NULL;
+    }
+    struct sd_rec *r = &sd->recs[sd_nrecs++];
+    *r = (struct sd_rec){ .base = base, .len = len, .req = req, .caller = caller };
+    return r;
+}
+
+void sdiag_boot_begin(void) {
+    asm volatile ("" :: "r"(sd_pad_rodata), "r"(sd_pad_bss) : "memory");
+    sd_e9("SDIAG BOOT\n");
+    if (sd != NULL) {
+        return;
+    }
+    EFI_PHYSICAL_ADDRESS addr = 0xffffffff;
+    UINTN pages = (sizeof(struct sd_big) + 4095) / 4096;
+    if (gBS->AllocatePages(AllocateMaxAddress, EfiLoaderData, pages, &addr) != EFI_SUCCESS) {
+        return;
+    }
+    sd = (struct sd_big *)(uintptr_t)addr;
+    for (size_t i = 0; i < pages * 4096 / 8; i++) {
+        ((uint64_t *)sd)[i] = 0;
+    }
+    sd_tracking = true;
+}
+
+void sdiag_alloc(void *p, uint64_t len, uint64_t requested, void *caller) {
+    sd_e9("SDIAG A %x %x LIMINE+%x\n", (uint64_t)(uintptr_t)p, len,
+          (uint64_t)((uintptr_t)caller - (uintptr_t)__slide));
+    if (!sd_tracking || p == NULL) {
+        return;
+    }
+    sd_add((uint64_t)(uintptr_t)p, ALIGN_UP(len, 4096, return), requested,
+           (uint32_t)((uintptr_t)caller - (uintptr_t)__slide));
+}
+
+void sdiag_free(void *p, uint64_t len) {
+    sd_e9("SDIAG F %x %x\n", (uint64_t)(uintptr_t)p, len);
+    if (!sd_tracking || p == NULL) {
+        return;
+    }
+    uint64_t lo = (uint64_t)(uintptr_t)p;
+    uint64_t hi = lo + ALIGN_UP(len == 0 ? 1 : len, 4096, return);
+    for (unsigned i = 0; i < sd_nrecs; ) {
+        struct sd_rec *r = &sd->recs[i];
+        uint64_t rlo = r->base, rhi = r->base + r->len;
+        if (rhi <= lo || rlo >= hi) {
+            i++;
+            continue;
+        }
+        if (rlo < lo && rhi <= hi && !(r->flags & SR_SEALED)) {
+            r->len = lo - rlo;
+            i++;
+            continue;
+        }
+        if (rlo >= lo && rhi > hi && !(r->flags & SR_SEALED)) {
+            r->base = hi;
+            r->len = rhi - hi;
+            i++;
+            continue;
+        }
+        sd->recs[i] = sd->recs[--sd_nrecs];
+    }
+}
+
+void sdiag_track(const void *p, uint64_t len, const char *name) {
+    if (!sd_on || len == 0) {
+        return;
+    }
+    uint64_t base = ALIGN_DOWN((uint64_t)(uintptr_t)p, 4096);
+    uint64_t top = ALIGN_UP((uint64_t)(uintptr_t)p + len, 4096, return);
+    struct sd_rec *r = sd_find(base);
+    if (r != NULL && r->base + r->len >= top) {
+        r->name = name;
+        return;
+    }
+    uint64_t req = (uint64_t)(uintptr_t)p - base + len;
+    r = sd_add(base, top - base, req <= SD_COPY_MAX ? req : 0, 0);
+    if (r != NULL) {
+        r->name = name;
+    }
+}
+
+void sdiag_name(const void *p, const char *name) {
+    struct sd_rec *r = sd_find((uint64_t)(uintptr_t)p);
+    if (r != NULL) {
+        r->name = name;
+    }
+}
+
+void sdiag_ignore(const void *p) {
+    struct sd_rec *r = sd_find((uint64_t)(uintptr_t)p);
+    if (r != NULL) {
+        r->flags |= SR_IGNORE;
+    }
+}
+
+static void sd_name_hhdm(uint64_t reported, const char *name) {
+    if (reported >= sd_hhdm) {
+        struct sd_rec *r = sd_find(reported - sd_hhdm);
+        if (r != NULL && r->name == NULL) {
+            r->name = name;
+        }
+    }
+}
+
+static void *sd_hhdm_ptr(uint64_t reported) {
+    struct sd_rec *r = reported >= sd_hhdm ? sd_find(reported - sd_hhdm) : NULL;
+    return r != NULL ? (void *)(uintptr_t)(reported - sd_hhdm) : NULL;
+}
+
+#define SD_IS(p, ID) ({ uint64_t _id[4] = ID; (p)[2] == _id[2] && (p)[3] == _id[3]; })
+
+static void sd_name_request(uint64_t *p) {
+    uint64_t resp = p[5];
+    if (resp == 0) {
+        return;
+    }
+    if (SD_IS(p, LIMINE_MEMMAP_REQUEST_ID)) {
+        struct limine_memmap_response *m = sd_hhdm_ptr(resp);
+        sd_name_hhdm(resp, "MEMMAP-RESP");
+        if (m != NULL) {
+            sd_name_hhdm(m->entries, "MEMMAP-LIST");
+            uint64_t *list = sd_hhdm_ptr(m->entries);
+            if (list != NULL && m->entry_count != 0) {
+                sd_name_hhdm(list[0], "MEMMAP-ENTRIES");
+            }
+        }
+    } else if (SD_IS(p, LIMINE_FRAMEBUFFER_REQUEST_ID)) {
+        struct limine_framebuffer_response *f = sd_hhdm_ptr(resp);
+        sd_name_hhdm(resp, "FB-RESP");
+        if (f != NULL) {
+            sd_name_hhdm(f->framebuffers, "FB-LIST");
+            uint64_t *list = sd_hhdm_ptr(f->framebuffers);
+            for (uint64_t i = 0; list != NULL && i < f->framebuffer_count; i++) {
+                struct limine_framebuffer *fb = sd_hhdm_ptr(list[i]);
+                sd_name_hhdm(list[i], "FB-STRUCT");
+                if (fb != NULL) {
+                    sd_name_hhdm(fb->modes, "FB-MODES");
+                }
+            }
+        }
+    } else if (SD_IS(p, LIMINE_MODULE_REQUEST_ID)) {
+        struct limine_module_response *m = sd_hhdm_ptr(resp);
+        sd_name_hhdm(resp, "MODULE-RESP");
+        if (m != NULL) {
+            sd_name_hhdm(m->modules, "MODULE-LIST");
+            uint64_t *list = sd_hhdm_ptr(m->modules);
+            for (uint64_t i = 0; list != NULL && i < m->module_count; i++) {
+                struct limine_file *f = sd_hhdm_ptr(list[i]);
+                sd_name_hhdm(list[i], "MODULE-STRUCTS");
+                if (f != NULL) {
+                    sd_name_hhdm(f->address, "MODULE-DATA");
+                    sd_name_hhdm(f->path, "MODULE-PATH");
+                    sd_name_hhdm(f->string, "MODULE-STRING");
+                }
+            }
+        }
+    } else if (SD_IS(p, LIMINE_EXECUTABLE_FILE_REQUEST_ID)) {
+        struct limine_executable_file_response *e = sd_hhdm_ptr(resp);
+        sd_name_hhdm(resp, "EXECFILE-RESP");
+        if (e != NULL) {
+            struct limine_file *f = sd_hhdm_ptr(e->executable_file);
+            sd_name_hhdm(e->executable_file, "EXECFILE-STRUCT");
+            if (f != NULL) {
+                sd_name_hhdm(f->address, "KERNEL-FILE");
+                sd_name_hhdm(f->path, "KERNEL-PATH");
