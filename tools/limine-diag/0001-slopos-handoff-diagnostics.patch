+
+// Bits the hardware or Limine change legitimately after the seal: the
+// accessed and dirty bits the APs' page walks set in the new pagemap, and the
+// TSS busy bit the APs' trampoline and spinup_go32 flip in the GDT copy.
+static uint64_t sd_mask(uint64_t addr, uint64_t w, uint32_t mode) {
+    if (mode & SR_PT) {
+        w &= ~(uint64_t)0x60;
+    }
+    if ((mode & SR_GDT) && addr == (sd_gdt_byte & ~(uint64_t)7)) {
+        w &= ~((uint64_t)2 << ((sd_gdt_byte & 7) * 8));
+    }
+    return w;
+}
+
+static uint64_t sd_word(uint64_t addr, uint32_t mode) {
+    return sd_mask(addr, *(const uint64_t *)(uintptr_t)addr, mode);
+}
+
+static uint64_t sd_hash(uint64_t addr, uint64_t len, uint32_t mode) {
+    uint64_t h = SD_FNV_OFF;
+    if (mode != 0) {
+        for (uint64_t off = 0; off < len; off += 8) {
+            h = (h ^ sd_word(addr + off, mode)) * SD_FNV_PRIME;
+        }
+        return h;
+    }
+    const uint64_t *p = (const uint64_t *)(uintptr_t)addr;
+    for (uint64_t i = 0; i < len / 8; i++) {
+        h = (h ^ p[i]) * SD_FNV_PRIME;
+    }
+    return h;
+}
+
+static uint32_t sd_fold32(uint64_t h) {
+    return (uint32_t)(h ^ (h >> 32));
+}
+
+static uint16_t sd_fold16(uint64_t h) {
+    uint32_t x = sd_fold32(h);
+    return (uint16_t)(x ^ (x >> 16));
+}
+
+static void sd_fine_compute(uint64_t page, uint32_t mode, struct sd_fine *out) {
+    uint64_t ph = SD_FNV_OFF;
+    for (unsigned c = 0; c < 64; c++) {
+        uint64_t h = sd_hash(page + c * 64, 64, mode);
+        out->chunk[c] = sd_fold16(h);
+        ph = (ph ^ h) * SD_FNV_PRIME;
+    }
+    out->page = sd_fold32(ph);
+}
+
+static uint64_t sd_group_len(const struct sd_rec *r, uint64_t i) {
+    uint64_t start = i * r->group * 4096;
+    uint64_t len = (uint64_t)r->group * 4096;
+    return len < r->len - start ? len : r->len - start;
+}
+
+static void sd_store(struct sd_rec *r, uint64_t lo, uint64_t hi) {
+    uint32_t mode = r->flags & SR_MASKED;
+    if (r->flags & SR_FINE) {
+        for (uint64_t off = 0; off < r->len; off += 4096) {
+            if (off + 4096 > lo && off < hi) {
+                sd_fine_compute(r->base + off, mode, &sd->fine[r->slot + off / 4096]);
+            }
+        }
+    } else if (r->flags & SR_COARSE) {
+        uint64_t glen = (uint64_t)r->group * 4096;
+        for (uint64_t i = 0; i * glen < r->len; i++) {
+            if (i * glen + glen > lo && i * glen < hi) {
+                sd->coarse[r->slot + i] = sd_fold32(sd_hash(r->base + i * glen, sd_group_len(r, i), mode));
+            }
+        }
+    }
+    if (r->flags & SR_COPY) {
+        for (uint64_t i = 0; i < r->req; i++) {
+            sd->copy[r->copy + i] = ((const uint8_t *)(uintptr_t)r->base)[i];
+        }
+    }
+}
+
+static void sd_seal_rec(struct sd_rec *r) {
+    uint64_t npages = r->len / 4096;
+    if (npages <= SD_FINE_PAGES && sd_nfine + npages <= SD_MAX_FINE) {
+        r->flags |= SR_FINE;
+        r->slot = sd_nfine;
+        r->group = 1;
+        sd_nfine += npages;
+    } else {
+        uint64_t room = SD_MAX_COARSE - sd_ncoarse;
+        uint64_t per = room < SD_COARSE_PER_OBJ ? room : SD_COARSE_PER_OBJ;
+        if (per == 0) {
+            r->flags |= SR_NOROOM | SR_SEALED;
+            return;
+        }
+        uint64_t g = (npages + per - 1) / per;
+        r->flags |= SR_COARSE;
+        r->slot = sd_ncoarse;
+        r->group = g;
+        sd_ncoarse += (npages + g - 1) / g;
+    }
+    if (r->req != 0 && r->req <= SD_COPY_MAX && sd_ncopy + r->req <= SD_COPY_BYTES) {
+        r->flags |= SR_COPY;
+        r->copy = sd_ncopy;
+        sd_ncopy += ALIGN_UP(r->req, 8, return);
+    }
+    sd_store(r, 0, r->len);
+    r->flags |= SR_SEALED;
+}
+
+void sdiag_seal(void) {
+    if (!sd_on) {
+        return;
+    }
+    for (unsigned i = 0; i < sd_nrecs; i++) {
+        if (!(sd->recs[i].flags & (SR_SEALED | SR_IGNORE))) {
+            sd_seal_rec(&sd->recs[i]);
+        }
+    }
+}
+
+void sdiag_reseal(const void *p, uint64_t len) {
+    if (!sd_on) {
+        return;
+    }
+    uint64_t lo = (uint64_t)(uintptr_t)p, hi = lo + len;
+    for (unsigned i = 0; i < sd_nrecs; i++) {
+        struct sd_rec *r = &sd->recs[i];
+        if ((r->flags & SR_SEALED) && hi > r->base && lo < r->base + r->len) {
+            sd_store(r, lo > r->base ? lo - r->base : 0, hi - r->base);
+        }
+    }
+}
+
+struct sd_bad {
+    struct sd_rec *r;
+    uint64_t addr;
+    uint64_t npages;
+    int chunk;
+    bool word;
+    uint64_t woff;
+    uint64_t was;
+    uint64_t now;
+};
+
+static bool sd_kernel_vs_file(struct sd_bad *bad, uint64_t lo, uint64_t hi);
+
+static void sd_check_copy(struct sd_rec *r, struct sd_bad *bad) {
+    if (!(r->flags & SR_COPY)) {
+        return;
+    }
+    uint32_t mode = r->flags & SR_MASKED;
+    for (uint64_t off = 0; off + 8 <= r->req; off += 8) {
+        uint64_t was = *(uint64_t *)(void *)&sd->copy[r->copy + off];
+        uint64_t now = sd_word(r->base + off, mode);
+        was = sd_mask(r->base + off, was, mode);
+        if (was != now) {
+            bad->word = true;
+            bad->woff = off;
+            bad->was = was;
+            bad->now = now;
+            return;
+        }
+    }
+}
+
+static bool sd_check_rec(struct sd_rec *r, struct sd_bad *bad) {
+    uint32_t mode = r->flags & SR_MASKED;
+    if (r->flags & SR_FINE) {
+        for (uint64_t off = 0; off < r->len; off += 4096) {
+            struct sd_fine now;
+            struct sd_fine *was = &sd->fine[r->slot + off / 4096];
+            sd_fine_compute(r->base + off, mode, &now);
+            if (now.page == was->page) {
+                continue;
+            }
+            *bad = (struct sd_bad){ .r = r, .addr = r->base + off, .npages = 1, .chunk = -1 };
+            for (int c = 0; c < 64; c++) {
+                if (now.chunk[c] != was->chunk[c]) {
+                    bad->chunk = c;
+                    break;
+                }
+            }
+            sd_check_copy(r, bad);
+            return true;
+        }
+    } else if (r->flags & SR_COARSE) {
+        uint64_t glen = (uint64_t)r->group * 4096;
+        for (uint64_t i = 0; i * glen < r->len; i++) {
+            uint64_t len = sd_group_len(r, i);
+            if (sd_fold32(sd_hash(r->base + i * glen, len, mode)) == sd->coarse[r->slot + i]) {
+                continue;
+            }
+            *bad = (struct sd_bad){ .r = r, .addr = r->base + i * glen, .npages = len / 4096, .chunk = -1 };
+            sd_check_copy(r, bad);
+            struct sd_bad exact;
+            if (r->base == sd_kbase && sd_kernel_vs_file(&exact, i * glen, i * glen + len)) {
+                bad->addr = exact.addr;
+                bad->npages = 1;
+                bad->word = true;
+                bad->woff = exact.woff;
+                bad->was = exact.was;
+                bad->now = exact.now;
+            }
+            return true;
+        }
+    }
+    return false;
+}
+
+static void sd_report_box(uint32_t bg, const char lines[][SD_LINE_MAX], unsigned n) {
+    unsigned used1 = sd_nlines > sd_rows ? sd_nlines - sd_rows : 0;
+    uint64_t y = sd_trail_y + (uint64_t)(used1 == 0 ? 0 : used1 + 1) * sd_lh;
+    uint64_t x = sd_half;
+    unsigned width = (unsigned)((sd_w - sd_half) / sd_cw) - 1;
+    sd_fill(x, y, (uint64_t)(width + 1) * sd_cw, (uint64_t)(n + 1) * sd_lh, bg);
+    for (unsigned i = 0; i < n; i++) {
+        sd_text(x + sd_cw / 2, y + sd_lh / 2 + (uint64_t)i * sd_lh, lines[i], width,
+                i == 0 ? SD_YELLOW : SD_WHITE, bg);
+    }
+    sd_flush();
+}
+
+static noreturn void sd_halt(void) {
+    for (;;) {
+        asm volatile ("cli; hlt" ::: "memory");
+    }
+}
+
+static const char *sd_rec_name(const struct sd_rec *r) {
+    return r->name != NULL ? r->name : "ALLOC";
+}
+
+static noreturn void sd_corrupt(const char *where, struct sd_bad *bad, unsigned others,
+                                struct sd_bad *also, unsigned nalso) {
+    char (*l)[SD_LINE_MAX] = sd->report;
+    unsigned n = 0;
+    struct sd_rec *r = bad->r;
+    sd_fmt(l[n++], SD_LINE_MAX, "CORRUPT %s", sd_rec_name(r));
+    sd_fmt(l[n++], SD_LINE_MAX, "FOUND AT CHECK %s, STEP %u", where, (uint64_t)sd_nsteps);
+    sd_fmt(l[n++], SD_LINE_MAX, "PAGE %x +%x IN OBJECT (%u PAGE%s)", bad->addr, bad->addr - r->base,
+           bad->npages, bad->npages == 1 ? "" : "S");
+    sd_fmt(l[n++], SD_LINE_MAX, "OBJECT %x LEN %x", r->base, r->len);
+    if (r->caller != 0) {
+        sd_fmt(l[n++], SD_LINE_MAX, "ALLOCATED FROM LIMINE+%x", (uint64_t)r->caller);
+    }
+    if (bad->word) {
+        sd_fmt(l[n++], SD_LINE_MAX, "FIRST DIFFERING WORD +%x", bad->woff);
+        sd_fmt(l[n++], SD_LINE_MAX, " WAS %X", bad->was);
+        sd_fmt(l[n++], SD_LINE_MAX, " NOW %X", bad->now);
+    } else if (bad->chunk >= 0) {
+        const uint64_t *q = (const uint64_t *)(uintptr_t)(bad->addr + (uint64_t)bad->chunk * 64);
+        sd_fmt(l[n++], SD_LINE_MAX, "CHANGED 64 BYTES AT +%x, NOW:", (uint64_t)bad->chunk * 64);
+        for (int i = 0; i < 8; i += 2) {
+            sd_fmt(l[n++], SD_LINE_MAX, " %X %X", q[i], q[i + 1]);
+        }
+    } else {
+        sd_fmt(l[n++], SD_LINE_MAX, "NO WORD DETAIL KEPT FOR THIS OBJECT");
+    }
+    for (unsigned i = 0; i < nalso && n < 18; i++) {
+        sd_fmt(l[n++], SD_LINE_MAX, "ALSO %s PAGE %x", sd_rec_name(also[i].r), also[i].addr);
+    }
+    if (others > nalso) {
+        sd_fmt(l[n++], SD_LINE_MAX, "+%u MORE CHANGED OBJECTS", (uint64_t)(others - nalso));
+    }
+    sd_in_fault = true;
+    sd_report_box(SD_BADBG, (const char (*)[SD_LINE_MAX])l, n);
+    sd_halt();
+}
+
+// Compares image offsets [lo, hi) of the kernel with the ELF file Limine loaded
+// it from, which is still in memory and which the kernel reads later.
+static bool sd_kernel_vs_file(struct sd_bad *bad, uint64_t lo, uint64_t hi) {
+    static struct sd_rec kfile_rec = { .name = "KERNEL VS ITS ELF FILE" };
+    const uint8_t *file = (const uint8_t *)(uintptr_t)sd_kfile;
+    if (file == NULL || sd_kfile_size < 64 || file[0] != 0x7f || file[1] != 'E'
+     || *(const uint16_t *)(file + 16) != SD_ET_EXEC) {
+        return false;
+    }
+    uint64_t phoff = *(const uint64_t *)(file + 32);
+    uint16_t phentsize = *(const uint16_t *)(file + 54), phnum = *(const uint16_t *)(file + 56);
+
+    for (uint16_t i = 0; i < phnum; i++) {
+        if (phoff + (uint64_t)(i + 1) * phentsize > sd_kfile_size) {
+            return false;
+        }
+        const uint8_t *ph = file + phoff + (uint64_t)i * phentsize;
+        if (*(const uint32_t *)ph != SD_PT_LOAD) {
+            continue;
+        }
+        uint64_t off = *(const uint64_t *)(ph + 8), vaddr = *(const uint64_t *)(ph + 16);
+        uint64_t filesz = *(const uint64_t *)(ph + 32), memsz = *(const uint64_t *)(ph + 40);
+        if (vaddr < sd_kvirt || off + filesz > sd_kfile_size) {
+            continue;
+        }
+        uint64_t img = sd_kbase + (vaddr - sd_kvirt);
+        uint64_t seg = vaddr - sd_kvirt;
+        if (hi <= seg || lo >= seg + memsz) {
+            continue;
+        }
+        uint64_t start = lo > seg ? ALIGN_DOWN(lo - seg, 8) : 0;
+        uint64_t end = hi - seg < memsz ? hi - seg : memsz;
+        for (uint64_t o = start; o + 8 <= end; o += 8) {
+            uint64_t want = o + 8 <= filesz ? *(const uint64_t *)(file + off + o) : 0;
+            uint64_t have = *(const uint64_t *)(uintptr_t)(img + o);
+            if (want == have || (o + 8 > filesz && o < filesz)) {
+                continue;
+            }
+            // Limine writes each response pointer and rewrites the base
+            // revision tag; anything else differing from the file is not its.
+            bool limine_wrote = false;
+            for (size_t k = 0; k < sd_requests_count; k++) {
+                if ((uint64_t)(uintptr_t)sd_requests[k] + 40 == img + o) {
+                    limine_wrote = true;
+                    break;
+                }
+            }
+            if (o + 8 <= filesz && o >= 8
+             && *(const uint64_t *)(file + off + o - 8) == SD_BASE_REVISION_MAGIC0
+             && want == SD_BASE_REVISION_MAGIC1) {
+                limine_wrote = true;
+            }
+            if (o + 8 <= filesz && o >= 16
+             && *(const uint64_t *)(file + off + o - 16) == SD_BASE_REVISION_MAGIC0
+             && *(const uint64_t *)(file + off + o - 8) == SD_BASE_REVISION_MAGIC1) {
+                limine_wrote = true;
+            }
+            if (limine_wrote) {
+                continue;
+            }
+            kfile_rec.base = sd_kbase;
+            kfile_rec.len = sd_ksize;
+            *bad = (struct sd_bad){ .r = &kfile_rec, .addr = ALIGN_DOWN(img + o, 4096), .npages = 1,
+                                    .chunk = -1, .word = true, .woff = img + o - sd_kbase,
+                                    .was = want, .now = have };
+            return true;
+        }
+    }
+    return false;
+}
+
+#ifdef SLOPOS_DIAG_TEST_CORRUPT
+#if SLOPOS_DIAG_TEST_CORRUPT + 0 == 0
+#undef SLOPOS_DIAG_TEST_CORRUPT
+#define SLOPOS_DIAG_TEST_CORRUPT 1
+#endif
+static void sd_test_corrupt(const char *where) {
+    const char *target = NULL;
+    const char *at = NULL;
+    switch (SLOPOS_DIAG_TEST_CORRUPT) {
+        case 1: target = "REQUESTS"; at = "EBS"; break;
+        case 2: target = "KERNEL"; at = "EBS"; break;
+        case 3: target = "PT-L1"; at = "SMP"; break;
+        case 4: target = "KERNEL"; at = "INIT"; break;
+    }
+    if (target == NULL || at == NULL || where[0] != at[0] || where[1] != at[1]) {
+        return;
+    }
+    for (unsigned i = 0; i < sd_nrecs; i++) {
+        const char *n = sd->recs[i].name;
+        if (n == NULL) {
+            continue;
+        }
+        size_t k = 0;
+        while (target[k] && n[k] == target[k]) {
+            k++;
+        }
+        if (target[k] == 0 && n[k] == 0) {
+            uint64_t off = sd->recs[i].len > 0x2000 ? 0x1238 : 0x10;
+            *(volatile uint64_t *)(uintptr_t)(sd->recs[i].base + off) ^= 0xdeadbeefcafef00dULL;
+            return;
+        }
+    }
+}
+#endif
+
+void sdiag_check(const char *where) {
+    if (!sd_on) {
+        return;
+    }
+#ifdef SLOPOS_DIAG_TEST_CORRUPT
+    sd_test_corrupt(where);
+#endif
+    sdiag_step(SDIAG_CHECK, "CHECK %s", where);
+    struct sd_bad first, also[SD_MAX_ALSO], cur;
+    unsigned nbad = 0, nalso = 0;
+    uint64_t pages = 0, objs = 0;
+    for (unsigned i = 0; i < sd_nrecs; i++) {
+        struct sd_rec *r = &sd->recs[i];
+        if (!(r->flags & SR_SEALED) || (r->flags & (SR_IGNORE | SR_NOROOM))) {
+            continue;
+        }
+        objs++;
+        pages += r->len / 4096;
+        if (!sd_check_rec(r, &cur)) {
+            continue;
+        }
+        if (nbad++ == 0) {
+            first = cur;
+        } else if (nalso < SD_MAX_ALSO) {
+            also[nalso++] = cur;
+        }
+    }
+    if (nbad == 0 && sd_kernel_vs_file(&cur, 0, sd_ksize)) {
+        first = cur;
+        nbad = 1;
+    }
+    if (nbad != 0) {
+        sd_corrupt(where, &first, nbad - 1, also, nalso);
+    }
+    sdiag_note(" OK %u OBJ %u PG", objs, pages);
+    if (sd_dropped != 0) {
+        sdiag_note(" %u UNTRACKED", (uint64_t)sd_dropped);
+    }
+}
+
+static void sd_track_pt(void *page, const char *name) {
+    sdiag_track(page, 4096, name);
+    struct sd_rec *r = sd_find((uint64_t)(uintptr_t)page);
+    if (r != NULL) {
+        r->flags |= SR_PT;
+    }
+}
+
+void sdiag_pagemap(void *top_level, int levels) {
+    static const char *const names[] = { "", "PT-L1", "PT-L2", "PT-L3", "PT-L4", "PT-L5" };
+    if (!sd_on || top_level == NULL || levels < 4 || levels > 5) {
+        return;
+    }
+    uint64_t stack[6][2];
+    unsigned depth = 0, count = 0;
+    stack[0][0] = (uint64_t)(uintptr_t)top_level;
+    stack[0][1] = 0;
+    sd_track_pt(top_level, names[levels]);
+    count++;
+    while (true) {
+        uint64_t *t = (uint64_t *)(uintptr_t)stack[depth][0];
+        int level = levels - (int)depth;
+        if (level <= 1 || stack[depth][1] >= 512) {
+            if (depth == 0) {
+                break;
+            }
+            depth--;
+            continue;
+        }
+        uint64_t e = t[stack[depth][1]++];
+        if (!(e & 1) || (level <= 3 && (e & 0x80))) {
+            continue;
+        }
+        uint64_t child = e & 0x000ffffffffff000ULL;
+        sd_track_pt((void *)(uintptr_t)child, names[level - 1]);
+        count++;
+        depth++;
+        stack[depth][0] = child;
+        stack[depth][1] = 0;
+    }
+    sdiag_note(" TOP=%x PT=%u", (uint64_t)(uintptr_t)top_level, (uint64_t)count);
+    sdiag_seal();
+}
+
+void sdiag_init(uint64_t kernel_phys, uint64_t kernel_virt, uint64_t hhdm,
+                void **requests, size_t requests_count,
+                struct mem_range *ranges, size_t ranges_count,
+                struct limine_file *kf, void *spinup_copy) {
+    struct fb_info *fbi = NULL;
+    if (sd != NULL && fb_fbs != NULL && fb_fbs_count > 0 && fb_fbs[0].framebuffer_bpp == 32) {
+        fbi = &fb_fbs[0];
+    }
+    if (fbi == NULL || fbi->framebuffer_addr == 0) {
+        sd_tracking = false;
+        return;
+    }
+
+    sd_fb_phys = fbi->framebuffer_addr;
+    sd_fb = (volatile uint32_t *)(uintptr_t)sd_fb_phys;
+    sd_w = fbi->framebuffer_width;
+    sd_h = fbi->framebuffer_height;
+    sd_pitch = fbi->framebuffer_pitch / 4;
+    sd_rsz = fbi->red_mask_size ? fbi->red_mask_size : 8;
+    sd_gsz = fbi->green_mask_size ? fbi->green_mask_size : 8;
+    sd_bsz = fbi->blue_mask_size ? fbi->blue_mask_size : 8;
+    sd_rsh = fbi->red_mask_size ? fbi->red_mask_shift : 16;
+    sd_gsh = fbi->green_mask_size ? fbi->green_mask_shift : 8;
+    sd_bsh = fbi->blue_mask_size ? fbi->blue_mask_shift : 0;
+
+    sd_s = (unsigned)(sd_h / 360);
+    if (sd_s > 3) {
+        sd_s = 3;
+    }
+    while (sd_s > 1 && sd_w / (6 * sd_s) < 100) {
+        sd_s--;
+    }
+    if (sd_s == 0) {
+        sd_s = 1;
+    }
+    sd_cw = 6 * sd_s;
+    sd_lh = 9 * sd_s;
+    sd_x0 = 8;
+    sd_y0 = 8;
+    sd_half = sd_w / 2;
+    sd_cols_full = (unsigned)((sd_w - sd_x0) / sd_cw);
+    sd_col_chars = (unsigned)((sd_half - sd_x0) / sd_cw);
+    if (sd_col_chars >= SD_LINE_MAX) {
+        sd_col_chars = SD_LINE_MAX - 1;
+    }
+    if (sd_cols_full >= SD_LINE_MAX) {
+        sd_cols_full = SD_LINE_MAX - 1;
+    }
+    sd_trail_y = sd_y0 + 5 * (uint64_t)sd_lh;
+    sd_rows = (unsigned)((sd_h - sd_trail_y) / sd_lh);
+    if (sd_rows == 0) {
+        sd_tracking = false;
+        return;
+    }
+    sd_on = true;
+
+    sd_kbase = kernel_phys;
+    sd_kvirt = kernel_virt;
+    sd_hhdm = hhdm;
+    sd_requests = requests;
+    sd_requests_count = requests_count;
+    for (size_t i = 0; i < ranges_count; i++) {
+        uint64_t top = ranges[i].base + ranges[i].length - kernel_virt;
+        if (top > sd_ksize) {
+            sd_ksize = top;
+        }
+    }
+    if (kf != NULL && kf->address >= hhdm) {
+        sd_kfile = kf->address - hhdm;
+        sd_kfile_size = kf->size;
+    }
+    asm volatile ("mov %%cr3, %0" : "=r"(sd_fw_cr3));
+
+    sd_install_idt();
+    sd_header();
+
+    // A box limine_spinup_32 paints through the new HHDM, just before iretq.
+    struct {
+        uint64_t addr;
+        uint32_t pitch;
+        uint32_t size;
+        uint32_t colour;
+        uint32_t pad;
+    } *mark = (void *)((uint8_t *)spinup_copy + ((uintptr_t)sdiag_jump_mark - (uintptr_t)limine_spinup_32));
+    uint32_t box = 12 * sd_s;
+    if (spinup_copy != NULL && sd_w > box + 8) {
+        mark->addr = hhdm + sd_fb_phys + 8 * fbi->framebuffer_pitch + (sd_w - box - 8) * 4;
+        mark->pitch = (uint32_t)fbi->framebuffer_pitch;
+        mark->size = box;
+        mark->colour = sd_px(SD_MARK);
+    }
+
+    sdiag_track((void *)(uintptr_t)kernel_phys, sd_ksize, "KERNEL");
+    sdiag_name(requests, "REQUESTS");
+    sdiag_name(ranges, "RANGES");
+    sdiag_track((void *)(uintptr_t)gdt.ptr, (uint64_t)gdt.limit + 1, "GDT");
+    struct sd_rec *g = sd_find(gdt.ptr);
+    if (g != NULL) {
+        g->flags |= SR_GDT;
+        sd_gdt_byte = gdt.ptr + 0x3d;
+    }
+    if (spinup_low_go32 != 0 && spinup_low_stack_top > spinup_low_go32) {
+        sdiag_track((void *)spinup_low_go32, spinup_low_stack_top - spinup_low_go32, "TRAMP");
+    }
+    if (sdiag_flush_idt() != NULL) {
+        sdiag_track(sdiag_flush_idt(), 256 * sizeof(struct idt_entry), "FLUSH-IDT");
+    }
+    sdiag_track(__slide, (uintptr_t)__text_end - (uintptr_t)__image_base, "LIMINE-TEXT");
+
+    sdiag_step(SDIAG_FB, "FB %x  KERNEL %x+%x", sd_fb_phys, sd_kbase, sd_ksize);
+#ifdef SLOPOS_DIAG_TEST_CORRUPT
+    sd_test_corrupt("INIT");
+#endif
+}
+
+void sdiag_set_stack(void *top, uint64_t size) {
+    if (!sd_on) {
+        return;
+    }
+    sd_stack_top = (uint64_t)(uintptr_t)top;
+    sdiag_name((uint8_t *)top - size, "STACK");
+    sd_header();
+}
+
+void sdiag_after_ebs(void) {
+    if (!sd_on) {
+        return;
+    }
+    struct sd_idtr cur;
+    asm volatile ("sidt %0" : "=m"(cur) :: "memory");
+    if (cur.base != (uint64_t)(uintptr_t)sd->idt_fw) {
+        sdiag_note(" FW RELOADED IDT %x", cur.base);
+        struct sd_idtr n = { sizeof(sd->idt_fw) - 1, (uint64_t)(uintptr_t)sd->idt_fw };
+        asm volatile ("lidt %0" :: "m"(n) : "memory");
+    }
+    sdiag_check("EBS");
+}
+
+void sdiag_mouse_init(size_t rel, size_t abs) {
+    sd_ptr_inits++;
+    sd_ptr_rel = (unsigned)rel;
+    sd_ptr_abs = (unsigned)abs;
+}
+
+void sdiag_getstate(void) {
+    sd_getstates++;
+}
+
+void sdiag_mouse_flush(void) {
+    sd_flushes++;
+}
+
+void sdiag_ap_begin(uint32_t lapic_id) {
+    sdiag_step(SDIAG_AP, "START AP LAPIC ID %x:", (uint64_t)lapic_id);
+}
+
+void sdiag_ap_end(bool booted) {
+    sdiag_note(booted ? " BOOTED" : " TIMED OUT (1 S)");
+}
+
+void sdiag_iommu_unit(const char *kind, uint64_t base, uint32_t status) {
+    sdiag_step(SDIAG_IOMMU, "%s %x STS=%x", kind, base, (uint64_t)status);
+}
+
+void sdiag_spinup_pre_flush(void) {
+    sd_e9("SDIAG SPINUP\n");
+    sdiag_note(" GDT+IDT OK, FLUSH IRQS:");
+#if defined (SLOPOS_DIAG_TEST_FAULT)
+    if (SLOPOS_DIAG_TEST_FAULT == SDIAG_SPINUP) {
+        sd_test_fault();
+    }
+#endif
+}
+
+void sdiag_spinup_post_flush(void) {
+    sdiag_note("OK");
+    sdiag_step(SDIAG_GO32, "TO 32-BIT, PAGING OFF, LIMINE_SPINUP_32");
+}
+
+static const char *const sd_vec_names[32] = {
+    "#DE", "#DB", "NMI", "#BP", "#OF", "#BR", "#UD", "#NM", "#DF", "", "#TS", "#NP",
+    "#SS", "#GP", "#PF", "", "#MF", "#AC", "#MC", "#XM", "#VE", "#CP",
+};
+
+// frame: vector, error code, then the CPU's RIP, CS, RFLAGS, RSP, SS.
+__attribute__((used)) noreturn void sdiag_fault(uint64_t *frame) {
+    if (sd_in_fault || !sd_on) {
+        sd_halt();
+    }
+    sd_in_fault = true;
+
+    uint64_t cr0, cr2, cr3, cr4;
+    asm volatile ("mov %%cr0, %0" : "=r"(cr0));
+    asm volatile ("mov %%cr2, %0" : "=r"(cr2));
+    asm volatile ("mov %%cr3, %0" : "=r"(cr3));
+    asm volatile ("mov %%cr4, %0" : "=r"(cr4));
+
+    uint64_t slide = (uint64_t)(uintptr_t)__slide;
+    uint64_t img = (uintptr_t)__image_end - (uintptr_t)__image_base;
+    uint64_t rip = frame[2];
+    char (*l)[SD_LINE_MAX] = sd->report;
+    unsigned n = 0;
+    const char *vname = frame[0] < 32 ? sd_vec_names[frame[0]] : NULL;
+    sd_fmt(l[n++], SD_LINE_MAX, "EXCEPTION %x %s  ERROR CODE %x", frame[0], vname != NULL ? vname : "", frame[1]);
+    if (rip >= slide && rip - slide < img) {
+        sd_fmt(l[n++], SD_LINE_MAX, "RIP %x = LIMINE+%x", rip, rip - slide);
+    } else {
+        sd_fmt(l[n++], SD_LINE_MAX, "RIP %x (OUTSIDE LIMINE)", rip);
+    }
+    sd_fmt(l[n++], SD_LINE_MAX, "CR2 %x", cr2);
+    sd_fmt(l[n++], SD_LINE_MAX, "RSP %x  CS %x", frame[5], frame[3]);
+    sd_fmt(l[n++], SD_LINE_MAX, "RFLAGS %x  SS %x", frame[4], frame[6]);
+    sd_fmt(l[n++], SD_LINE_MAX, "CR3 %x  CR0 %x", cr3, cr0);
+    sd_fmt(l[n++], SD_LINE_MAX, "CR4 %x  SLIDE %x", cr4, slide);
+    sd_fmt(l[n++], SD_LINE_MAX, "LAST STEP %u:", (uint64_t)sd_nsteps);
+    if (sd_nlines > 0) {
+        sd_fmt(l[n++], SD_LINE_MAX, " %s", sd->lines[sd_step_line]);
+        if (sd_cur != sd_step_line) {
+            sd_fmt(l[n++], SD_LINE_MAX, " %s", sd->lines[sd_cur]);
+        }
+    }
+    sd_report_box(SD_FAULTBG, (const char (*)[SD_LINE_MAX])l, n);
+    sd_halt();
+}
+
+#endif
