+
+struct sd_idtr {
+    uint16_t limit;
+    uint64_t base;
+} __attribute__((packed));
+
+// Loaded by common_spinup in place of its limit-0 IDT; still limit 0 when the
+// diagnostics are off, which is what stock loads there.
+struct sd_idtr sdiag_idtr_spinup = { 0, 0 };
+
+static bool sd_on;
+static bool sd_tracking;
+static volatile uint32_t *sd_fb;
+static uint64_t sd_fb_phys, sd_w, sd_h, sd_pitch;
