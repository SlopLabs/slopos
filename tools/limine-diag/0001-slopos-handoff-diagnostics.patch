+// SPDX-License-Identifier: BSD-2-Clause
+// SlopOS handoff diagnostics for Limine. Not part of upstream Limine; a
+// derivative of it under the same licence (see COPYING).
+//
+// Between fb_init and the jump to the executable Limine draws nothing, and a
+// CPU exception lands in a firmware IDT nobody services or, once the handoff
+// GDT is loaded, triple-faults. On a machine without a serial port that is a
+// black screen. This draws into framebuffer 0 instead: a trail of the steps
+// reached, a report of any CPU exception, and a report of any page Limine
+// handed out that changed behind its back. It never calls Limine's allocator
+// and the build keeps the image stock-sized, so the memory layout it watches
+// is the one stock Limine produces.
+
+#if defined (__x86_64__) && defined (UEFI)
+
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+#include <stdarg.h>
+#include <config.h>
+#include <lib/slopos_diag.h>
+#include <lib/fb.h>
+#include <lib/misc.h>
+#include <lib/elf.h>
+#include <mm/pmm.h>
+#include <sys/cpu.h>
+#include <sys/gdt.h>
+#include <sys/idt.h>
+#include <menu.h>
+#define LIMINE_NO_POINTERS
+#include <limine.h>
+
+#define SDIAG_VARIANT "STD"
+
+#define SD_MAX_LINES 80
+#define SD_LINE_MAX 112
+#define SD_MAX_RECS 320
+#define SD_MAX_FINE 128
+#define SD_FINE_PAGES 8
+#define SD_MAX_COARSE 6144
