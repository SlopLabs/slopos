diff --git a/common/lib/slopos_diag_stubs.asm_uefi_x86_64 b/common/lib/slopos_diag_stubs.asm_uefi_x86_64
new file mode 100644
index 0000000..37a3a1b
--- /dev/null
+++ b/common/lib/slopos_diag_stubs.asm_uefi_x86_64
@@ -0,0 +1,74 @@
+; SPDX-License-Identifier: BSD-2-Clause
+; SlopOS handoff diagnostics for Limine: exception entry stubs. Not part of
+; upstream Limine; a derivative of it under the same licence (see COPYING).
+;
+; Each stub leaves vector, error code (0 where the CPU pushes none), RIP, CS,
+; RFLAGS, RSP and SS on the stack, lowest address first, and passes that frame
+; to sdiag_fault(), which does not return.
+
+section .text
+bits 64
+
+extern sdiag_fault
+
+%macro SDIAG_STUB 2
+sdiag_stub_%1:
+%if %2 == 0
+    push 0
+%endif
+    push %1
+    jmp sdiag_stub_common
+%endmacro
+
+SDIAG_STUB 0, 0
+SDIAG_STUB 1, 0
+SDIAG_STUB 2, 0
+SDIAG_STUB 3, 0
+SDIAG_STUB 4, 0
+SDIAG_STUB 5, 0
+SDIAG_STUB 6, 0
+SDIAG_STUB 7, 0
+SDIAG_STUB 8, 1
+SDIAG_STUB 9, 0
+SDIAG_STUB 10, 1
+SDIAG_STUB 11, 1
+SDIAG_STUB 12, 1
+SDIAG_STUB 13, 1
+SDIAG_STUB 14, 1
+SDIAG_STUB 15, 0
+SDIAG_STUB 16, 0
+SDIAG_STUB 17, 1
+SDIAG_STUB 18, 0
+SDIAG_STUB 19, 0
+SDIAG_STUB 20, 0
+SDIAG_STUB 21, 1
+SDIAG_STUB 22, 0
+SDIAG_STUB 23, 0
+SDIAG_STUB 24, 0
+SDIAG_STUB 25, 0
+SDIAG_STUB 26, 0
+SDIAG_STUB 27, 0
+SDIAG_STUB 28, 0
+SDIAG_STUB 29, 1
+SDIAG_STUB 30, 1
+SDIAG_STUB 31, 0
+
+sdiag_stub_common:
+    cld
+    mov rdi, rsp
+    and rsp, -16
+    call sdiag_fault
+.hang:
+    cli
+    hlt
+    jmp .hang
+
+section .data
+align 8
+global sdiag_stubs
+sdiag_stubs:
+%assign i 0
+%rep 32
+    dq sdiag_stub_ %+ i
+%assign i i+1
+%endrep
